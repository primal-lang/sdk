/*
  Input: a positive integer
  Output: the list of all the divisors of that number
*/

divisors(n) = divisors_helper(n, 1)

divisors_helper(n, x) = if (x > n)
                            []
                        else if ((n % x) == 0)
                            x + divisors_helper(n, x + 1)
                        else
                            divisors_helper(n, x + 1)

main() = divisors(10)