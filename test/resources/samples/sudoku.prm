getRows(list) =
  list_chunk(list, 9)

getColumns(rows, colIndex) =
  list_map(rows, (row) -> row[colIndex])

getBlocks(rows, rowIndex, colIndex) =
  list_flatten([
    list_sublist(rows[rowIndex], colIndex, colIndex + 3),
    list_sublist(rows[rowIndex + 1], colIndex, colIndex + 3),
    list_sublist(rows[rowIndex + 2], colIndex, colIndex + 3)
  ])

getCandidates(value, values, row, col, blo) =
  if (value != 0)
    [value]
  else
    removeFromValues(values, list_flatten([row, col, blo]))

removeFromValues(values, numbers) =
  list_filter(values, (v) -> !list_contains(numbers, v))

candidatesForCell(list, index) =
  let
    rows = getRows(list),
    rowIndex = num_floor(index / 9),
    colIndex = num_mod(index, 9),
    bloRow = num_floor(rowIndex / 3) * 3,
    bloCol = num_floor(colIndex / 3) * 3,
    row = rows[rowIndex],
    col = getColumns(rows, colIndex),
    blo = getBlocks(rows, bloRow, bloCol),
    values = [1, 2, 3, 4, 5, 6, 7, 8, 9]
  in
    getCandidates(list[index], values, row, col, blo)

tryCandidates(candidates, list, index) =
  if (list_isEmpty(candidates))
    []
  else
    let
      attempt = solveSudoku(list_set(list, index, list_first(candidates)))
    in
      if (list_isNotEmpty(attempt))
        attempt
      else
        tryCandidates(list_rest(candidates), list, index)

solveSudoku(list) =
  let
    emptyIndex = list_indexOf(list, 0)
  in
    if (emptyIndex == -1)
      list
    else
      tryCandidates(candidatesForCell(list, emptyIndex), list, emptyIndex)

main() = solveSudoku([
  9, 0, 0,   5, 0, 8,   0, 0, 7,
  0, 8, 0,   3, 0, 2,   9, 0, 5,
  0, 5, 4,   0, 0, 0,   0, 8, 0,

  0, 7, 0,   6, 8, 0,   0, 3, 2,
  1, 0, 0,   0, 0, 4,   0, 0, 8,
  5, 0, 0,   2, 1, 9,   0, 6, 0,

  0, 0, 0,   9, 0, 6,   0, 0, 1,
  7, 2, 6,   0, 0, 1,   0, 4, 0,
  0, 0, 1,   4, 7, 0,   0, 5, 6
])

