  9, 1, 3,   5, 6, 8,   4, 2, 7,
  6, 8, 7,   3, 4, 2,   9, 1, 5,
  2, 5, 4,   1, 9, 7,   6, 8, 3,

  4, 7, 9,   6, 8, 5,   1, 3, 2,
  1, 6, 2,   7, 3, 4,   5, 9, 8,
  5, 3, 8,   2, 1, 9,   7, 6, 4,

  3, 4, 5,   9, 2, 6,   8, 7, 1,
  7, 2, 6,   8, 5, 1,   3, 4, 9,
  8, 9, 1,   4, 7, 3,   2, 5, 6
*/