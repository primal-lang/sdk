/*
  Input: a list with the values in each position of the grid
  Output: a list wit the values of the solved sudoku
*/

removeFromValues(values, numbers) =
  list_filter(values, (v) -> !list_contains(numbers, v))

pos(value, values, row, col, blo) =
  if (value != 0)
    [value]
  else
    removeFromValues(values, list_flatten([row, col, blo]))

solveSudoku(list) =
  let
    rows = list_chunk(list, 9),
    row1 = rows[0],
    row2 = rows[1],
    row3 = rows[2],
    row4 = rows[3],
    row5 = rows[4],
    row6 = rows[5],
    row7 = rows[6],
    row8 = rows[7],
    row9 = rows[8],
    col = (c) -> list_map(rows, (row) -> row[c]),
    col1 = col(0),
    col2 = col(1),
    col3 = col(2),
    col4 = col(3),
    col5 = col(4),
    col6 = col(5),
    col7 = col(6),
    col8 = col(7),
    col9 = col(8),
    blo = (r, c) -> list_flatten([
      list_sublist(rows[r], c, c + 3),
      list_sublist(rows[r + 1], c, c + 3),
      list_sublist(rows[r + 2], c, c + 3)
    ]),
    blo1 = blo(0, 0),
    blo2 = blo(0, 3),
    blo3 = blo(0, 6),
    blo4 = blo(3, 0),
    blo5 = blo(3, 3),
    blo6 = blo(3, 6),
    blo7 = blo(6, 0),
    blo8 = blo(6, 3),
    blo9 = blo(6, 6),
    values = [1, 2, 3, 4, 5, 6, 7, 8, 9],
    pos11 = pos(list[0], values, row1, col1, blo1),
    pos12 = pos(list[1], values, row1, col2, blo1)
  in
    pos12

main() = solveSudoku([
  9, 0, 0,   5, 0, 8,   0, 0, 7,
  0, 8, 0,   3, 0, 2,   9, 0, 5,
  0, 5, 4,   0, 0, 0,   0, 8, 0,

  0, 7, 0,   6, 8, 0,   0, 3, 2,
  1, 0, 0,   0, 0, 4,   0, 0, 8,
  5, 0, 0,   2, 1, 9,   0, 6, 0,

  0, 0, 0,   9, 0, 6,   0, 0, 1,
  7, 2, 6,   0, 0, 1,   0, 4, 0,
  0, 0, 1,   4, 7, 0,   0, 5, 6
])

