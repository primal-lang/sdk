/*
  Input: a list with the values in each position of the grid
  Output: a list wit the values of the solved sudoku
*/

removeFromValues(values, numbers) =
  list_filter(values, (v) -> !list_contains(numbers, v))

pos(value, values, row, col, blo) =
  if (value != 0)
    [value]
  else
    removeFromValues(values, list_flatten([row, col, blo]))

solveSudoku(list) =
  let
    rows = list_chunk(list, 9),
    row1 = rows[0],
    row2 = rows[1],
    row3 = rows[2],
    row4 = rows[3],
    row5 = rows[4],
    row6 = rows[5],
    row7 = rows[6],
    row8 = rows[7],
    row9 = rows[8],
    col = (c) -> list_map(rows, (row) -> row[c]),
    col1 = col(0),
    col2 = col(1),
    col3 = col(2),
    col4 = col(3),
    col5 = col(4),
    col6 = col(5),
    col7 = col(6),
    col8 = col(7),
    col9 = col(8),
    blo = (r, c) -> list_flatten([
      list_sublist(rows[r], c, c + 3),
      list_sublist(rows[r + 1], c, c + 3),
      list_sublist(rows[r + 2], c, c + 3)
    ]),
    blo1 = blo(0, 0),
    blo2 = blo(0, 3),
    blo3 = blo(0, 6),
    blo4 = blo(3, 0),
    blo5 = blo(3, 3),
    blo6 = blo(3, 6),
    blo7 = blo(6, 0),
    blo8 = blo(6, 3),
    blo9 = blo(6, 6),
    values = [1, 2, 3, 4, 5, 6, 7, 8, 9],
    pos11 = pos(list[0], values, row1, col1, blo1),
    pos12 = pos(list[1], values, row1, col2, blo1),
    pos13 = pos(list[2], values, row1, col3, blo1),
    pos14 = pos(list[3], values, row1, col4, blo2),
    pos15 = pos(list[4], values, row1, col5, blo2),
    pos16 = pos(list[5], values, row1, col6, blo2),
    pos17 = pos(list[6], values, row1, col7, blo3),
    pos18 = pos(list[7], values, row1, col8, blo3),
    pos19 = pos(list[8], values, row1, col9, blo3),
    pos21 = pos(list[9], values, row2, col1, blo1),
    pos22 = pos(list[10], values, row2, col2, blo1),
    pos23 = pos(list[11], values, row2, col3, blo1),
    pos24 = pos(list[12], values, row2, col4, blo2),
    pos25 = pos(list[13], values, row2, col5, blo2),
    pos26 = pos(list[14], values, row2, col6, blo2),
    pos27 = pos(list[15], values, row2, col7, blo3),
    pos28 = pos(list[16], values, row2, col8, blo3),
    pos29 = pos(list[17], values, row2, col9, blo3),
    pos31 = pos(list[18], values, row3, col1, blo1),
    pos32 = pos(list[19], values, row3, col2, blo1),
    pos33 = pos(list[20], values, row3, col3, blo1),
    pos34 = pos(list[21], values, row3, col4, blo2),
    pos35 = pos(list[22], values, row3, col5, blo2),
    pos36 = pos(list[23], values, row3, col6, blo2),
    pos37 = pos(list[24], values, row3, col7, blo3),
    pos38 = pos(list[25], values, row3, col8, blo3),
    pos39 = pos(list[26], values, row3, col9, blo3),
    pos41 = pos(list[27], values, row4, col1, blo4),
    pos42 = pos(list[28], values, row4, col2, blo4),
    pos43 = pos(list[29], values, row4, col3, blo4),
    pos44 = pos(list[30], values, row4, col4, blo5),
    pos45 = pos(list[31], values, row4, col5, blo5),
    pos46 = pos(list[32], values, row4, col6, blo5),
    pos47 = pos(list[33], values, row4, col7, blo6),
    pos48 = pos(list[34], values, row4, col8, blo6),
    pos49 = pos(list[35], values, row4, col9, blo6),
    pos51 = pos(list[36], values, row5, col1, blo4),
    pos52 = pos(list[37], values, row5, col2, blo4),
    pos53 = pos(list[38], values, row5, col3, blo4),
    pos54 = pos(list[39], values, row5, col4, blo5),
    pos55 = pos(list[40], values, row5, col5, blo5),
    pos56 = pos(list[41], values, row5, col6, blo5),
    pos57 = pos(list[42], values, row5, col7, blo6),
    pos58 = pos(list[43], values, row5, col8, blo6),
    pos59 = pos(list[44], values, row5, col9, blo6),
    pos61 = pos(list[45], values, row6, col1, blo4),
    pos62 = pos(list[46], values, row6, col2, blo4),
    pos63 = pos(list[47], values, row6, col3, blo4),
    pos64 = pos(list[48], values, row6, col4, blo5),
    pos65 = pos(list[49], values, row6, col5, blo5),
    pos66 = pos(list[50], values, row6, col6, blo5),
    pos67 = pos(list[51], values, row6, col7, blo6),
    pos68 = pos(list[52], values, row6, col8, blo6),
    pos69 = pos(list[53], values, row6, col9, blo6),
    pos71 = pos(list[54], values, row7, col1, blo7),
    pos72 = pos(list[55], values, row7, col2, blo7),
    pos73 = pos(list[56], values, row7, col3, blo7),
    pos74 = pos(list[57], values, row7, col4, blo8),
    pos75 = pos(list[58], values, row7, col5, blo8),
    pos76 = pos(list[59], values, row7, col6, blo8),
    pos77 = pos(list[60], values, row7, col7, blo9),
    pos78 = pos(list[61], values, row7, col8, blo9),
    pos79 = pos(list[62], values, row7, col9, blo9),
    pos81 = pos(list[63], values, row8, col1, blo7),
    pos82 = pos(list[64], values, row8, col2, blo7),
    pos83 = pos(list[65], values, row8, col3, blo7),
    pos84 = pos(list[66], values, row8, col4, blo8),
    pos85 = pos(list[67], values, row8, col5, blo8),
    pos86 = pos(list[68], values, row8, col6, blo8),
    pos87 = pos(list[69], values, row8, col7, blo9),
    pos88 = pos(list[70], values, row8, col8, blo9),
    pos89 = pos(list[71], values, row8, col9, blo9),
    pos91 = pos(list[72], values, row9, col1, blo7),
    pos92 = pos(list[73], values, row9, col2, blo7),
    pos93 = pos(list[74], values, row9, col3, blo7),
    pos94 = pos(list[75], values, row9, col4, blo8),
    pos95 = pos(list[76], values, row9, col5, blo8),
    pos96 = pos(list[77], values, row9, col6, blo8),
    pos97 = pos(list[78], values, row9, col7, blo9),
    pos98 = pos(list[79], values, row9, col8, blo9),
    pos99 = pos(list[80], values, row9, col9, blo9)
  in
    []

main() = solveSudoku([
  9, 0, 0,   5, 0, 8,   0, 0, 7,
  0, 8, 0,   3, 0, 2,   9, 0, 5,
  0, 5, 4,   0, 0, 0,   0, 8, 0,

  0, 7, 0,   6, 8, 0,   0, 3, 2,
  1, 0, 0,   0, 0, 4,   0, 0, 8,
  5, 0, 0,   2, 1, 9,   0, 6, 0,

  0, 0, 0,   9, 0, 6,   0, 0, 1,
  7, 2, 6,   0, 0, 1,   0, 4, 0,
  0, 0, 1,   4, 7, 0,   0, 5, 6
])

