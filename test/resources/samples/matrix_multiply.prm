/*
  Input: two matrices (lists of lists of numbers)
  Output: the product of the two matrices
*/

matMul(a, b) = matMul_rows(a, b, 0)

matMul_rows(a, b, i) =
    if (i >= list_length(a))
        []
    else
        list_insertStart(matMul_rows(a, b, i + 1), matMul_row(a[i], b))

matMul_row(aRow, b) = matMul_cols(aRow, b, 0)

matMul_cols(aRow, b, j) =
    if (j >= list_length(b[0]))
        []
    else
        matMul_dot(aRow, b, j, 0, 0) + matMul_cols(aRow, b, j + 1)

matMul_dot(aRow, b, j, k, sum) =
    if (k >= list_length(aRow))
        sum
    else
        matMul_dot(aRow, b, j, k + 1, sum + aRow[k] * matMul_cell(b[k], j))

matMul_cell(row, j) = row[j]

main() = matMul([[1, 2], [3, 4]], [[5, 6], [7, 8]])