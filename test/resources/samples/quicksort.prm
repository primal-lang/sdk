/*
  Input: a list of numbers
  Output: the list sorted in ascending order using the quicksort algorithm
*/

quicksort(list) =
    if (list_isEmpty(list))
        []
    else
        let
            pivot = list_first(list),
            rest = list_rest(list)
        in
            quicksort(list_filter(rest, (x) -> x < pivot)) + pivot + quicksort(list_filter(rest, (x) -> x >= pivot))

main() = quicksort([38, 27, 43, 3, 9])