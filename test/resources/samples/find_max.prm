/*
  Input: a list of numbers
  Output: the maximum number in the list
*/

findMax(list) = if (list_isEmpty(list))
                    error_throw(-1, 'Cannot find max number in an empty list')
                else
                    list_reduce(list_rest(list), list_first(list), num_max)

main() = findMax([1, 7, -13, 9, 2])