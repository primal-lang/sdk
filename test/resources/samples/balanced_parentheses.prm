/*
  Input: a string containing opening and closing parentheses
  Output: true if the parentheses are balanced, false otherwise
*/

balancedParenthesis(list) = balancedParenthesis_helper(list, stack_new([]))

balancedParenthesis_helper(list, stack) =
    if (str_isEmpty(list))
        stack_isEmpty(stack)
    else if (str_first(list) == '(')
        balancedParenthesis_helper(str_rest(list), stack_push(stack, '('))
    else if (str_first(list) == ')')
        if ((stack_isNotEmpty(stack)) && (stack_peek(stack) == '('))
            balancedParenthesis_helper(str_rest(list), stack_pop(stack))
        else
            false
    else
        error_throw(-1, 'Invalid element in the list: "' + str_first(list) + '"')

main() = balancedParenthesis("((((()()(()))())))")