/*
  Input: a list of elements
  Output: a map with the elements as keys and the amount of appearances in the list as a value
*/

frequency(list) = frequency_helper(list, {})

frequency_helper(list, result) =
    if (list_isEmpty(list))
        result
    else
        frequency_count(list_first(list), list_rest(list), result)

frequency_count(first, rest, result) =
    if (map_containsKey(result, first))
        frequency_helper(rest, map_set(result, first, result[first] + 1))
    else
        frequency_helper(rest, map_set(result, first, 1))

main() = frequency([1, 2, 2, 3, 1, 4, 5, 2, 2, 5])