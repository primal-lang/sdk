/*
  Input: a positive integer
  Output: the first n numbers in the Fibonacci sequence
*/

fibonacci(n) = if (n < 0)
                   error_throw(-1, 'Cannot calculate Fibonacci with a negative number')
               else if (n == 0)
                   []
               else
                   fibonacci(n - 1) + fibonacci_helper(n)

fibonacci_helper(n) = if ((n == 1) || (n == 2))
                          1
                      else
                          fibonacci_helper(n - 1) + fibonacci_helper(n - 2)

main() = fibonacci(10)