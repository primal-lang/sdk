#!/usr/bin/env primal

greeting() = "Hello, world!"

farewell() = 'Goodbye, world!'

pi() = 3.14

rationalNumber() = pi()

isToday() = true

// Returns true if x is equal to zero
isZero(x) = x == 0

// Returns true if x is an even number
isEven(x) = (x % 2) == 0

// Returns true if x is an odd number
isOdd(x) = !isEven(x)

isBiggerThan10(x) = if (x > 10)   // if x is greater than 10, return true
                        true
                    else        // otherwise, return false
                        false

factorial(n) = if (n < 0)
			       error_throw(0, 'Cannot calculate factorial of a negative number')
			   else if (n == 0)
				   1
			   else
                   n * factorial(n - 1)

main() = factorial(4)

// --- Constants ---

test_greeting() = assert_equal(greeting(), "Hello, world!")

test_farewell() = assert_equal(farewell(), "Goodbye, world!")

test_pi() = assert_equal(pi(), 3.14)

test_rationalNumber() = assert_equal(rationalNumber(), pi())

test_isToday() = assert_true(isToday())

// --- Predicates ---

test_isZero() =
    assert_true(isZero(0)) &&
    assert_false(isZero(1)) &&
    assert_false(isZero(-1))

test_isEven() =
    assert_true(isEven(0)) &&
    assert_true(isEven(4)) &&
    assert_true(isEven(-2)) &&
    assert_false(isEven(3))

test_isOdd() =
    assert_true(isOdd(3)) &&
    assert_false(isOdd(4)) &&
    assert_notEqual(isOdd(7), isEven(7))

test_isBiggerThan10() =
    assert_true(isBiggerThan10(11)) &&
    assert_false(isBiggerThan10(10)) &&
    assert_false(isBiggerThan10(-5))

// --- Factorial ---

test_factorial_base() = assert_equal(factorial(0), 1)

test_factorial_one() = assert_equal(factorial(1), 1)

test_factorial_small() = assert_equal(factorial(4), 24)

test_factorial_larger() = assert_equal(factorial(5), 120)

test_factorial_negative() = assert_throws(factorial(-1))